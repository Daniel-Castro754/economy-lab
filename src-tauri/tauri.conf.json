{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Economy Lab",
  "version": "2.11.0",
  "identifier": "org.economylab.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Economy Lab",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/economy-lab-backend"
    ]
  }
}
